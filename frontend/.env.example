# Frontend (Vite) — public vars must use VITE_ prefix
# Local backend:
VITE_API_URL=http://localhost:5000

# After backend is deployed (Render/Railway), switch to:
# VITE_API_URL=https://your-backend.onrender.com

# Groq key for AI chat lives on the BACKEND in production:
# backend/.env → GROQ_API_KEY=gsk_...
