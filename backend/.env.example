# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/taskforge

# JWT signing secret (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret

# Frontend origin(s) for CORS + Socket.IO (comma-separated if multiple)
# Local:
CLIENT_URL=http://localhost:5173
# After Vercel deploy, also include your Vercel URL, e.g.:
# CLIENT_URL=http://localhost:5173,https://your-app.vercel.app

# Free Groq key for AI Chat: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# Optional model override
# GROQ_MODEL=llama-3.3-70b-versatile

# Port is set automatically by Render/Railway; locally defaults to 5000
# PORT=5000
